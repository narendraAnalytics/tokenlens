APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# GCP — auth via Application Default Credentials, not API keys.
# Run: gcloud auth application-default login
GCP_PROJECT_ID=
GCP_REGION=asia-south1

# BigQuery trace warehouse (populated in Phase 1 §3)
BIGQUERY_DATASET=tokenlens_traces

# Pub/Sub telemetry buffer (populated in Phase 1 §5)
PUBSUB_TOPIC_TRACES=
PUBSUB_DLQ_TOPIC=

# Cloud SQL control store (populated in Phase 2 §1). Local dev connects
# through the Cloud SQL Auth Proxy on 127.0.0.1:5432 — never a public IP.
DATABASE_URL=

# Cloud SQL instance connection name, for cloud-sql-proxy (not read by the
# app itself — DATABASE_URL above is what backend/config.py actually uses).
CLOUD_SQL_CONNECTION_NAME=
